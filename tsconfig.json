{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["node", "vitest"]
  },
  "include": [
    "main/**/*.ts",
    "preload/**/*.ts",
    "renderer/**/*.ts",
    "shared/**/*.ts",
    "storage/**/*.ts",
    "tests/**/*.ts"
  ]
}
