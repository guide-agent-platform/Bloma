{
  "name": "guide-agent-platform-sprint0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-main/main/index.js",
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "esbuild main/index.ts --bundle --platform=node --external:electron --format=esm --outfile=dist-main/main/index.js && esbuild preload/bridge.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-main/preload/bridge.cjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run tests/integration",
    "lint": "tsc --noEmit",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "dependencies": {
    "electron": "^39.0.0",
    "jotai": "^2.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
