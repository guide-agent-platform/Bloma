{
  "name": "guide-agent-platform-sprint0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-main/main/index.js",
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "esbuild main/index.ts --bundle --platform=node --external:electron --format=esm --outfile=dist-main/main/index.js && esbuild preload/bridge.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-main/preload/bridge.cjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:regression:sprint0": "vitest run tests/regression/sprint0",
    "test:regression:sprint1": "vitest run tests/regression/sprint1",
    "test:acceptance:sprint0": "npm run build && vitest run tests/acceptance/sprint0",
    "test:acceptance:sprint1": "vitest run tests/acceptance/sprint1",
    "test:acceptance:sprint2": "vitest run tests/acceptance/sprint2",
    "test:acceptance:sprint3": "vitest run tests/acceptance/sprint3",
    "test:electron-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/electron-startup-smoke.ps1",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:regression:sprint0 && npm run test:regression:sprint1 && npm run test:acceptance:sprint0 && npm run test:acceptance:sprint1 && npm run test:acceptance:sprint2 && npm run test:acceptance:sprint3",
    "lint": "tsc --noEmit",
    "docs:check": "node scripts/docs-check.mjs",
    "seed:channel": "electron scripts/seed-channel.cjs"
  },
  "dependencies": {
    "electron": "^39.0.0",
    "jotai": "^2.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.0.5"
  }
}
