{
  "case_id":"files-quick",
  "ready":"document.readyState==='complete' && !!document.querySelector('#btn-scan')",
  "steps":[
    {"kind":"write_file","name":"创建固定输入a","file":"input/a.txt","text":"alpha"},
    {"kind":"write_file","name":"创建固定输入b","file":"input/b.txt","text":"beta"},
    {"kind":"write_file","name":"创建已有目标以制造重名","file":"input/done-a.txt","text":"existing"},
    {"kind":"write_file","name":"创建选定目录外的哨兵","file":"outside/sentinel.txt","text":"outside-original"},
    {"kind":"js","name":"通过真实输入框选择目录并预览前缀","expression":"document.querySelector('#inp-folder').value={{DATA_DIR}}+'/input'; document.querySelector('#inp-prefix').value='done-'; document.querySelector('#btn-scan').click(); document.querySelector('#inp-prefix').dispatchEvent(new Event('input')); true"},
    {"kind":"expect","name":"重名提示并阻止执行","expression":"document.querySelector('#conflict-alert').style.display!=='none' && document.querySelector('#btn-execute').disabled && document.body.innerText.includes('冲突')"},
    {"kind":"file_tree","name":"冲突预览没有覆盖或改名","directory":"input","files":{"a.txt":"alpha","b.txt":"beta","done-a.txt":"existing"}},
    {"kind":"remove_file","name":"移除测试重名目标以恢复环境","file":"input/done-a.txt"},
    {"kind":"js","name":"重新扫描得到可执行预览","expression":"document.querySelector('#btn-scan').click(); true"},
    {"kind":"expect","name":"两条新旧名可见且可确认","expression":"!document.querySelector('#btn-execute').disabled && document.querySelector('#preview-area').textContent.includes('done-a.txt') && document.querySelector('#preview-area').textContent.includes('done-b.txt')"},
    {"kind":"file_tree","name":"点击执行前磁盘仍为原名","directory":"input","files":{"a.txt":"alpha","b.txt":"beta"}},
    {"kind":"lock","name":"锁定a以制造真实改名失败","file":"input/a.txt"},
    {"kind":"lock","name":"锁定b避免测试出现混合写入","file":"input/b.txt"},
    {"kind":"js","name":"点击确认执行并触发真实文件错误","expression":"document.querySelector('#btn-execute').click(); true"},
    {"kind":"expect","name":"失败如实上屏并结束运行态","expression":"document.body.innerText.includes('失败') && !document.querySelector('#btn-execute').disabled"},
    {"kind":"unlock","name":"解除a测试锁","file":"input/a.txt"},
    {"kind":"unlock","name":"解除b测试锁","file":"input/b.txt"},
    {"kind":"file_tree","name":"失败后原文件名和字节完整","directory":"input","files":{"a.txt":"alpha","b.txt":"beta"}},
    {"kind":"js","name":"环境恢复后重新预览","expression":"document.querySelector('#btn-scan').click(); true"},
    {"kind":"expect","name":"恢复后允许再次确认执行","expression":"!document.querySelector('#btn-execute').disabled"},
    {"kind":"js","name":"再次确认执行改名","expression":"document.querySelector('#btn-execute').click(); true"},
    {"kind":"expect","name":"本次改名有可撤销的结果","expression":"!document.querySelector('#btn-undo').disabled && document.querySelector('#result-card').style.display!=='none'"},
    {"kind":"file_tree","name":"改名结果与固定预览一致且内容未变","directory":"input","files":{"done-a.txt":"alpha","done-b.txt":"beta"}},
    {"kind":"js","name":"真实点击撤销本次改名","expression":"document.querySelector('#btn-undo').click(); true"},
    {"kind":"expect","name":"撤销完成且没有可重复撤销的记录","expression":"document.querySelector('#btn-undo').disabled"},
    {"kind":"file_tree","name":"撤销恢复原名与原字节","directory":"input","files":{"a.txt":"alpha","b.txt":"beta"}},
    {"kind":"js","name":"尝试目录穿越前缀","expression":"document.querySelector('#inp-prefix').value='../'; document.querySelector('#inp-prefix').dispatchEvent(new Event('input')); true"},
    {"kind":"expect","name":"目录穿越前缀得到明确拒绝","expression":"document.querySelector('#err-prefix').textContent.length>0 && document.body.innerText.includes('前缀不可用')"},
    {"kind":"js","name":"即使尝试点击也不得越界改写","expression":"document.querySelector('#btn-execute').click(); true"},
    {"kind":"file_tree","name":"越界尝试未改变选定目录","directory":"input","files":{"a.txt":"alpha","b.txt":"beta"}},
    {"kind":"file_tree","name":"选定目录外哨兵保持原字节","directory":"outside","files":{"sentinel.txt":"outside-original"}}
  ]
}
